# The regression baseline is generated by scripts/regression-snapshot.ts, which
# always writes LF. Without this, core.autocrlf=true checks the file out as CRLF
# on Windows, so regenerating it leaves the working tree permanently reported as
# modified and a byte-level diff against a fresh run reports every line changed.
scripts/__snapshots__/*.json text eol=lf

# 重みテーブルの CSV も生成側が常に LF で書く（gen_*_table.py）。同じ理由で
# 固定しておく。Excel で編集して CRLF になっても、コミット時に LF へ正規化され
# 差分は中身だけになる。
data/weights/*.csv text eol=lf
